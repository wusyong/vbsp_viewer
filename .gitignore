/target

# Valve's map data cannot be redistributed -- regenerate it from your own TF2
# install (see crates/tf2-bevy-viewer/README.md). The glb is ~170 MB anyway.
/crates/tf2-bevy-viewer/assets/maps/
shot.png

# Upstream vbsp ships two .bsp fixtures (24 MB) used only by its bench and one
# of its unit tests. Vendoring them would mean redistributing map data, so they
# are fetched on demand -- see crates/VENDORING.md.
/crates/vbsp/*.bsp
